---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Yuta's Website",
  description = "The personal website of Yuta, a software developer and student.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="google-site-verification"
      content="YfGY2IUXnG1rRkJNLUfyYcopokIFugM3vJAn3tknWnI"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    color: #f0f6fc;
    background-color: #0d1117;
    font-family: sans-serif;
  }
</style>
