---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Layout
  title="Blog · Yuta"
  description="Notes from Yuta on software, systems, and the web."
>
  <Navigation />

  <main>
    <header class="intro">
      <p class="eyebrow">Writing</p>
      <h1>Blog</h1>
      <p>Notes on software, systems, and the web.</p>
    </header>

    {
      posts.length > 0 ? (
        <ol class="posts">
          {posts.map((post) => (
            <li>
              <article>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {dateFormatter.format(post.data.publishedAt)}
                </time>
                <h2>
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p>{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <ul class="tags" aria-label="Tags">
                    {post.data.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">No posts yet. Check back soon.</p>
      )
    }
  </main>
</Layout>

<style>
  main {
    box-sizing: border-box;
    width: min(100% - 3rem, 42rem);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 0;
  }
  .intro {
    margin-bottom: 3.5rem;
  }
  .eyebrow {
    margin: 0 0 1.25rem;
    color: #58a6ff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .intro > p:last-child {
    max-width: 32rem;
    margin: 1.25rem 0 0;
    color: #c9d1d9;
    font-size: 1.1rem;
    line-height: 1.65;
  }
  .posts {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(240 246 252 / 10%);
  }
  article {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgb(240 246 252 / 10%);
  }
  time {
    color: #8b949e;
    font-size: 0.85rem;
  }
  h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    letter-spacing: -0.025em;
  }
  h2 a {
    color: #f0f6fc;
    text-decoration: none;
  }
  h2 a:hover {
    color: #58a6ff;
  }
  article p {
    margin: 0.55rem 0 0;
    color: #c9d1d9;
    line-height: 1.6;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    border: 1px solid rgb(88 166 255 / 28%);
    padding: 0.18rem 0.45rem;
    color: #8b949e;
    font-size: 0.75rem;
  }
  .empty {
    border-top: 1px solid rgb(240 246 252 / 10%);
    border-bottom: 1px solid rgb(240 246 252 / 10%);
    margin: 0;
    padding: 1.5rem 0;
    color: #8b949e;
  }
  @media (max-width: 32rem) {
    main {
      width: min(100% - 2rem, 42rem);
      padding-top: 2.5rem;
    }
    .intro {
      margin-bottom: 2.75rem;
    }
  }
</style>
