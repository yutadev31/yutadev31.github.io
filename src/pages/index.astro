---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
---

<Layout>
  <Navigation />

  <main>
    <p class="eyebrow">Software Developer &amp; Student</p>
    <h1>Hi, I’m Yuta.</h1>
    <p class="introduction">
      I build software for the web and enjoy exploring systems, Unix-like operating
      systems, and open source.
    </p>

    <div class="actions">
      <a class="primary-action" href="/about">About me <span aria-hidden="true">→</span></a>
      <a class="secondary-action" href="/links">Find me online <span aria-hidden="true">↗</span></a>
    </div>
  </main>
</Layout>

<style>
  main {
    box-sizing: border-box;
    display: grid;
    align-content: center;
    width: min(100% - 3rem, 42rem);
    min-height: calc(100dvh - 4.75rem);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 0;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: #58a6ff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #f0f6fc;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .introduction {
    max-width: 35rem;
    margin: 1.5rem 0 0;
    color: #c9d1d9;
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .primary-action {
    color: #0d1117;
    background: #f0f6fc;
  }

  .primary-action:hover {
    background: #c9d1d9;
  }

  .secondary-action {
    border: 1px solid rgb(240 246 252 / 16%);
    color: #f0f6fc;
  }

  .secondary-action:hover {
    border-color: rgb(88 166 255 / 55%);
    background: rgb(88 166 255 / 9%);
  }

  .actions a:focus-visible {
    outline: 2px solid #58a6ff;
    outline-offset: 3px;
  }

  @media (max-width: 32rem) {
    main {
      width: min(100% - 2rem, 42rem);
      min-height: calc(100dvh - 4.25rem);
      padding-top: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .actions a {
      transition: none;
    }
  }
</style>
